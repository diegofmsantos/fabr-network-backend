generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Time {
  id              Int           @id @default(autoincrement())
  nome            String
  sigla           String
  cor             String
  cidade          String
  bandeira_estado String
  fundacao        String
  logo            String
  capacete        String
  instagram       String
  instagram2      String
  estadio         String
  presidente      String
  head_coach      String
  instagram_coach String
  coord_ofen      String
  coord_defen     String
  titulos         Json
  temporada       String
  jogadores       JogadorTime[]

  // ✅ NOVOS RELACIONAMENTOS PARA DISTRIBUIÇÃO
  distribuicaoRegional DistribuicaoTime[] // Novo relacionamento

  playoffClassificado1 PlayoffJogo[] @relation("PlayoffTime1")
  playoffClassificado2 PlayoffJogo[] @relation("PlayoffTime2")
  playoffVitorias      PlayoffJogo[] @relation("PlayoffVencedor")

  jogosCasa        Jogo[]               @relation("JogosCasa")
  jogosVisitante   Jogo[]               @relation("JogosVisitante")
  estatisticasJogo EstatisticaJogo[]

  @@unique([sigla, temporada])
}

model Jogador {
  id               Int               @id @default(autoincrement())
  nome             String
  posicao          String
  setor            String
  experiencia      Int
  idade            Int
  altura           Float
  peso             Float
  instagram        String
  instagram2       String
  cidade           String
  nacionalidade    String
  timeFormador     String
  times            JogadorTime[]
  estatisticasJogo EstatisticaJogo[]
}

model JogadorTime {
  id           Int    @id @default(autoincrement())
  jogadorId    Int
  timeId       Int
  temporada    String
  numero       Int
  camisa       String
  estatisticas Json

  jogador Jogador @relation(fields: [jogadorId], references: [id])
  time    Time    @relation(fields: [timeId], references: [id])

  @@unique([jogadorId, timeId, temporada])
}

model Materia {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String
  imagem     String
  legenda    String?
  texto      String   @db.Text
  autor      String
  autorImage String
  createdAt  DateTime
  updatedAt  DateTime
}

model MetaDados {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String @db.Text
}

model Campeonato {
  id         Int       @id @default(autoincrement())
  nome       String
  temporada  String
  status     String
  dataInicio DateTime
  dataFim    DateTime?
  descricao  String?

  isSuperliga     Boolean @default(false)
  configSuperliga Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jogos        Jogo[]
  conferencias Conferencia[]
  PlayoffJogo  PlayoffJogo[]
  
  // ✅ NOVO RELACIONAMENTO PARA DISTRIBUIÇÃO
  distribuicoesTimes DistribuicaoTime[]

  @@index([temporada])
  @@index([status])
}

model Conferencia {
  id           Int    @id @default(autoincrement())
  nome         String 
  tipo         String 
  icone        String 
  campeonatoId Int
  ordem        Int 
  totalTimes   Int

  campeonato   Campeonato    @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  regionais    Regional[]
  playoffJogos PlayoffJogo[]
  
  // ✅ NOVO RELACIONAMENTO PARA DISTRIBUIÇÃO
  distribuicoesTimes DistribuicaoTime[]

  @@unique([campeonatoId, tipo])
  @@index([campeonatoId])
}

model Regional {
  id               Int    @id @default(autoincrement())
  nome             String
  tipo             String
  conferenciaId    Int
  ordem            Int
  timesPorRegional Int

  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  
  // ✅ NOVO RELACIONAMENTO PARA DISTRIBUIÇÃO
  distribuicoesTimes DistribuicaoTime[]

  @@unique([conferenciaId, tipo])
  @@index([conferenciaId])
}

// ✅ NOVA TABELA PARA DISTRIBUIÇÃO DE TIMES
model DistribuicaoTime {
  id           Int @id @default(autoincrement())
  campeonatoId Int
  conferenciaId Int
  regionalId   Int
  timeId       Int
  temporada    String
  
  // Campos para facilitar consultas
  conferenciaType String // SUDESTE, SUL, NORDESTE, CENTRO NORTE
  regionalType    String // SERRAMAR, CANASTRA, etc.
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  campeonato  Campeonato  @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  regional    Regional    @relation(fields: [regionalId], references: [id], onDelete: Cascade)
  time        Time        @relation(fields: [timeId], references: [id], onDelete: Cascade)

  // ✅ ÍNDICES PARA PERFORMANCE
  @@unique([campeonatoId, timeId, temporada]) // Um time por campeonato/temporada
  @@index([campeonatoId, temporada])
  @@index([conferenciaId])
  @@index([regionalId])
  @@index([timeId])
  @@index([temporada])
}

model PlayoffJogo {
  id            Int    @id @default(autoincrement())
  campeonatoId  Int
  conferenciaId Int?
  fase          String 
  rodada        Int 
  nome          String 

  timeClassificado1Id Int? 
  timeClassificado2Id Int? 
  jogoAnterior1Id     Int?
  jogoAnterior2Id     Int? 

  timeVencedorId Int? 
  dataJogo       DateTime?
  local          String?
  status         String    @default("AGUARDANDO") 
  placarTime1    Int?
  placarTime2    Int?
  observacoes    String?

  campeonato  Campeonato   @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  conferencia Conferencia? @relation(fields: [conferenciaId], references: [id], onDelete: SetNull)

  timeClassificado1 Time? @relation("PlayoffTime1", fields: [timeClassificado1Id], references: [id])
  timeClassificado2 Time? @relation("PlayoffTime2", fields: [timeClassificado2Id], references: [id])
  timeVencedor      Time? @relation("PlayoffVencedor", fields: [timeVencedorId], references: [id])

  jogoAnterior1 PlayoffJogo? @relation("JogoSequencia1", fields: [jogoAnterior1Id], references: [id])
  jogoAnterior2 PlayoffJogo? @relation("JogoSequencia2", fields: [jogoAnterior2Id], references: [id])

  proximosJogos1 PlayoffJogo[] @relation("JogoSequencia1")
  proximosJogos2 PlayoffJogo[] @relation("JogoSequencia2")

  @@index([campeonatoId, fase, rodada])
  @@index([conferenciaId])
}

model Jogo {
  id                      Int      @id @default(autoincrement())
  campeonatoId            Int
  timeVisitanteId         Int
  timeCasaId              Int
  dataJogo                DateTime
  local                   String?
  rodada                  Int
  fase                    String
  status                  String   @default("AGENDADO")
  placarCasa              Int?
  placarVisitante         Int?
  observacoes             String?
  estatisticasProcessadas Boolean  @default(false)
  
  // ✅ NOVOS CAMPOS PARA MELHOR CONTROLE
  conferencia             String?  // Para facilitar consultas
  regional                String?  // Para facilitar consultas
  temporada               String?  // Campo redundante mas útil para consultas rápidas
  
  // ✅ CAMPOS DE AUDITORIA
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  campeonato    Campeonato        @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  timeCasa      Time              @relation("JogosCasa", fields: [timeCasaId], references: [id])
  timeVisitante Time              @relation("JogosVisitante", fields: [timeVisitanteId], references: [id])
  estatisticas  EstatisticaJogo[]

  @@index([campeonatoId, rodada])
  @@index([dataJogo])
  @@index([status])
  @@index([timeCasaId])
  @@index([timeVisitanteId])
  @@index([conferencia]) // ✅ NOVO ÍNDICE
  @@index([regional])    // ✅ NOVO ÍNDICE
  @@index([temporada])   // ✅ NOVO ÍNDICE
  @@index([fase])        // ✅ NOVO ÍNDICE
}

model EstatisticaJogo {
  id           Int  @id @default(autoincrement())
  jogoId       Int
  jogadorId    Int
  timeId       Int
  estatisticas Json
  
  // ✅ NOVOS CAMPOS PARA MELHOR CONTROLE
  temporada    String?  // Para facilitar consultas
  rodada       Int?     // Para facilitar relatórios
  fase         String?  // Para separar temporada regular de playoffs
  
  // ✅ CAMPOS DE AUDITORIA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jogo    Jogo    @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  jogador Jogador @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  time    Time    @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@unique([jogoId, jogadorId])
  @@index([jogoId])
  @@index([jogadorId])
  @@index([timeId])      // ✅ NOVO ÍNDICE
  @@index([temporada])   // ✅ NOVO ÍNDICE
  @@index([rodada])      // ✅ NOVO ÍNDICE
  @@index([fase])        // ✅ NOVO ÍNDICE
}