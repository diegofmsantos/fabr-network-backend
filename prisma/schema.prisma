generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Time {
  id              Int           @id @default(autoincrement())
  nome            String
  sigla           String
  cor             String
  cidade          String
  bandeira_estado String
  fundacao        String
  logo            String
  capacete        String
  instagram       String
  instagram2      String
  estadio         String
  presidente      String
  head_coach      String
  instagram_coach String
  coord_ofen      String
  coord_defen     String
  titulos         Json
  temporada       String
  jogadores       JogadorTime[]

  playoffClassificado1 PlayoffJogo[] @relation("PlayoffTime1")
  playoffClassificado2 PlayoffJogo[] @relation("PlayoffTime2")
  playoffVitorias      PlayoffJogo[] @relation("PlayoffVencedor")

  // Relacionamentos com campeonatos
  grupos           GrupoTime[]
  jogosCasa        Jogo[]               @relation("JogosCasa")
  jogosVisitante   Jogo[]               @relation("JogosVisitante")
  estatisticasJogo EstatisticaJogo[]
  classificacoes   ClassificacaoGrupo[]

  @@unique([sigla, temporada])
}

model Jogador {
  id               Int               @id @default(autoincrement())
  nome             String
  posicao          String
  setor            String
  experiencia      Int
  idade            Int
  altura           Float
  peso             Float
  instagram        String
  instagram2       String
  cidade           String
  nacionalidade    String
  timeFormador     String
  times            JogadorTime[]
  estatisticasJogo EstatisticaJogo[]
}

model JogadorTime {
  id           Int    @id @default(autoincrement())
  jogadorId    Int
  timeId       Int
  temporada    String
  numero       Int
  camisa       String
  estatisticas Json

  jogador Jogador @relation(fields: [jogadorId], references: [id])
  time    Time    @relation(fields: [timeId], references: [id])

  @@unique([jogadorId, timeId, temporada])
}

model Materia {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String
  imagem     String
  legenda    String?
  texto      String   @db.Text
  autor      String
  autorImage String
  createdAt  DateTime
  updatedAt  DateTime
}

model MetaDados {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String @db.Text
}

model Campeonato {
  id         Int       @id @default(autoincrement())
  nome       String
  temporada  String
  status     String
  dataInicio DateTime
  dataFim    DateTime?
  descricao  String?

  isSuperliga     Boolean @default(false)
  configSuperliga Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grupos       Grupo[]
  jogos        Jogo[]
  conferencias Conferencia[]
  PlayoffJogo  PlayoffJogo[]

  @@index([temporada])
  @@index([status])
}

model Conferencia {
  id           Int    @id @default(autoincrement())
  nome         String 
  tipo         String 
  icone        String 
  campeonatoId Int
  ordem        Int 
  totalTimes   Int

  campeonato   Campeonato    @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  regionais    Regional[]
  playoffJogos PlayoffJogo[]

  @@unique([campeonatoId, tipo])
  @@index([campeonatoId])
}

model Regional {
  id               Int    @id @default(autoincrement())
  nome             String
  tipo             String
  conferenciaId    Int
  ordem            Int
  timesPorRegional Int

  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  grupos      Grupo[]

  @@unique([conferenciaId, tipo])
  @@index([conferenciaId])
}

model Grupo {
  id           Int    @id @default(autoincrement())
  nome         String
  campeonatoId Int
  regionalId   Int?
  ordem        Int

  campeonato     Campeonato           @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  regional       Regional?            @relation(fields: [regionalId], references: [id], onDelete: SetNull)
  times          GrupoTime[]
  jogos          Jogo[]
  classificacoes ClassificacaoGrupo[]

  @@unique([campeonatoId, nome])
  @@index([campeonatoId])
}

model GrupoTime {
  id      Int @id @default(autoincrement())
  grupoId Int
  timeId  Int

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  time  Time  @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@unique([grupoId, timeId])
}

model PlayoffJogo {
  id            Int    @id @default(autoincrement())
  campeonatoId  Int
  conferenciaId Int?
  fase          String 
  rodada        Int 
  nome          String 

  timeClassificado1Id Int? 
  timeClassificado2Id Int? 
  jogoAnterior1Id     Int?
  jogoAnterior2Id     Int? 

  timeVencedorId Int? 
  dataJogo       DateTime?
  local          String?
  status         String    @default("AGUARDANDO") 
  placarTime1    Int?
  placarTime2    Int?
  observacoes    String?

  campeonato  Campeonato   @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  conferencia Conferencia? @relation(fields: [conferenciaId], references: [id], onDelete: SetNull)

  timeClassificado1 Time? @relation("PlayoffTime1", fields: [timeClassificado1Id], references: [id])
  timeClassificado2 Time? @relation("PlayoffTime2", fields: [timeClassificado2Id], references: [id])
  timeVencedor      Time? @relation("PlayoffVencedor", fields: [timeVencedorId], references: [id])

  jogoAnterior1 PlayoffJogo? @relation("JogoSequencia1", fields: [jogoAnterior1Id], references: [id])
  jogoAnterior2 PlayoffJogo? @relation("JogoSequencia2", fields: [jogoAnterior2Id], references: [id])

  proximosJogos1 PlayoffJogo[] @relation("JogoSequencia1")
  proximosJogos2 PlayoffJogo[] @relation("JogoSequencia2")

  @@index([campeonatoId, fase, rodada])
  @@index([conferenciaId])
}

model Jogo {
  id                      Int      @id @default(autoincrement())
  campeonatoId            Int
  grupoId                 Int?
  timeVisitanteId         Int
  timeCasaId              Int
  dataJogo                DateTime
  local                   String?
  rodada                  Int
  fase                    String
  status                  String   @default("AGENDADO")
  placarCasa              Int?
  placarVisitante         Int?
  observacoes             String?
  estatisticasProcessadas Boolean  @default(false)

  campeonato    Campeonato        @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  grupo         Grupo?            @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  timeCasa      Time              @relation("JogosCasa", fields: [timeCasaId], references: [id])
  timeVisitante Time              @relation("JogosVisitante", fields: [timeVisitanteId], references: [id])
  estatisticas  EstatisticaJogo[]

  @@index([campeonatoId, rodada])
  @@index([dataJogo])
  @@index([status])
  @@index([timeCasaId])
  @@index([timeVisitanteId])
}

model EstatisticaJogo {
  id           Int  @id @default(autoincrement())
  jogoId       Int
  jogadorId    Int
  timeId       Int
  estatisticas Json

  jogo    Jogo    @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  jogador Jogador @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  time    Time    @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@unique([jogoId, jogadorId])
  @@index([jogoId])
  @@index([jogadorId])
}

model ClassificacaoGrupo {
  id             Int   @id @default(autoincrement())
  grupoId        Int
  timeId         Int
  posicao        Int
  jogos          Int   @default(0)
  vitorias       Int   @default(0)
  empates        Int   @default(0)
  derrotas       Int   @default(0)
  pontosPro      Int   @default(0)
  pontosContra   Int   @default(0)
  saldoPontos    Int   @default(0)
  pontos         Int   @default(0)
  aproveitamento Float @default(0)

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  time  Time  @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@unique([grupoId, timeId])
  @@index([grupoId, posicao])
}
