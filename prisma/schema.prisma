generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Time {
  id              Int           @id @default(autoincrement())
  nome            String
  sigla           String
  cor             String
  cidade          String
  bandeira_estado String
  fundacao        String
  logo            String
  capacete        String
  instagram       String
  instagram2      String
  estadio         String
  presidente      String
  head_coach      String
  instagram_coach String
  coord_ofen      String
  coord_defen     String
  titulos         Json
  temporada       String
  jogadores       JogadorTime[]

  distribuicaoRegional DistribuicaoTime[]

  jogosCasa        Jogo[]            @relation("JogosCasa")
  jogosVisitante   Jogo[]            @relation("JogosVisitante")
  estatisticasJogo EstatisticaJogo[]

  @@unique([sigla, temporada])
}

model Jogador {
  id               Int               @id @default(autoincrement())
  nome             String
  posicao          String?
  setor            String?
  experiencia      Int?
  idade            Int?
  altura           Float?
  peso             Float?
  instagram        String?
  instagram2       String?
  cidade           String?
  nacionalidade    String?
  timeFormador     String?
  times            JogadorTime[]
  estatisticasJogo EstatisticaJogo[]
}

model JogadorTime {
  id           Int    @id @default(autoincrement())
  jogadorId    Int
  timeId       Int
  temporada    String
  numero       Int
  camisa       String
  estatisticas Json

  jogador Jogador @relation(fields: [jogadorId], references: [id])
  time    Time    @relation(fields: [timeId], references: [id])

  @@unique([jogadorId, timeId, temporada])
}

model Materia {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String
  imagem     String
  legenda    String?
  texto      String   @db.Text
  autor      String
  autorImage String
  createdAt  DateTime
  updatedAt  DateTime
}

model Campeonato {
  id         Int       @id @default(autoincrement())
  nome       String
  temporada  String
  status     String
  dataInicio DateTime
  dataFim    DateTime?
  descricao  String?

  isSuperliga     Boolean @default(false)
  configSuperliga Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jogos            Jogo[]
  conferencias     Conferencia[]
  distribuicaoTime DistribuicaoTime[]
  estatisticasJogo EstatisticaJogo[]

  @@unique([temporada, isSuperliga])
  @@index([temporada])
  @@index([status])
}

model Jogo {
  id                      Int      @id @default(autoincrement())
  campeonatoId            Int
  timeVisitanteId         Int? // ← 1. Tornar opcional
  timeCasaId              Int? // ← 2. Tornar opcional
  dataJogo                DateTime
  local                   String?
  rodada                  Int
  fase                    String
  status                  String   @default("AGENDADO")
  placarCasa              Int?
  placarVisitante         Int?
  observacoes             String?
  estatisticasProcessadas Boolean  @default(false)

  nome           String?
  timeVencedorId Int?

  conferencia String?
  regional    String?
  temporada   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campeonato    Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  timeCasa      Time?      @relation("JogosCasa", fields: [timeCasaId], references: [id])
  timeVisitante Time?      @relation("JogosVisitante", fields: [timeVisitanteId], references: [id])

  conferenciaRelacao Conferencia? @relation("ConferenciaJogos", fields: [conferenciaId], references: [id])
  regionalRelacao    Regional?    @relation("RegionalJogos", fields: [regionalId], references: [id])
  conferenciaId      Int?
  regionalId         Int?

  estatisticas EstatisticaJogo[]

  @@index([campeonatoId, rodada])
  @@index([dataJogo])
  @@index([status])
  @@index([conferencia])
  @@index([regional])
  @@index([temporada])
  @@index([fase])
  @@index([campeonatoId, fase])
}

model Conferencia {
  id           Int    @id @default(autoincrement())
  nome         String
  tipo         String
  icone        String
  campeonatoId Int
  ordem        Int
  totalTimes   Int

  campeonato Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  regionais  Regional[]

  distribuicaoTime DistribuicaoTime[]

  jogos Jogo[] @relation("ConferenciaJogos")

  @@unique([campeonatoId, tipo])
  @@index([campeonatoId])
}

model Regional {
  id               Int    @id @default(autoincrement())
  nome             String
  tipo             String
  conferenciaId    Int
  ordem            Int
  timesPorRegional Int

  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  distribuicaoTime DistribuicaoTime[]

  jogos Jogo[] @relation("RegionalJogos")

  @@unique([conferenciaId, tipo])
  @@index([conferenciaId])
}

model DistribuicaoTime {
  id            Int    @id @default(autoincrement())
  campeonatoId  Int
  conferenciaId Int
  regionalId    Int
  timeId        Int
  temporada     String

  conferenciaType String
  regionalType    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  time        Time        @relation(fields: [timeId], references: [id], onDelete: Cascade)
  campeonato  Campeonato  @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)
  regional    Regional    @relation(fields: [regionalId], references: [id], onDelete: Cascade)

  @@unique([campeonatoId, timeId, temporada])
  @@index([campeonatoId, temporada])
  @@index([conferenciaId])
  @@index([regionalId])
  @@index([timeId])
  @@index([temporada])
}

model EstatisticaJogo {
  id           Int  @id @default(autoincrement())
  jogoId       Int
  jogadorId    Int
  timeId       Int
  campeonatoId Int
  estatisticas Json

  temporada String?
  rodada    Int?
  fase      String?

  jogo       Jogo       @relation(fields: [jogoId], references: [id])
  jogador    Jogador    @relation(fields: [jogadorId], references: [id])
  time       Time       @relation(fields: [timeId], references: [id])
  campeonato Campeonato @relation(fields: [campeonatoId], references: [id])

  @@unique([jogoId, jogadorId])
  @@index([campeonatoId, timeId])
  @@index([campeonatoId, jogadorId])
}
