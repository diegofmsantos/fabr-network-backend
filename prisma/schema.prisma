generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Time {
  id              Int           @id @default(autoincrement())
  nome            String
  sigla           String
  cor             String
  cidade          String
  bandeira_estado String
  fundacao        String
  logo            String
  capacete        String
  instagram       String
  instagram2      String
  estadio         String
  presidente      String
  head_coach      String
  instagram_coach String
  coord_ofen      String
  coord_defen     String
  titulos         Json
  temporada       String
  jogadores       JogadorTime[]

  @@unique([sigla, temporada]) 

  // Relacionamentos com campeonatos
  grupos           GrupoTime[]
  jogosCasa        Jogo[] @relation("JogosCasa")
  jogosVisitante   Jogo[] @relation("JogosVisitante")
  estatisticasJogo EstatisticaJogo[]
  classificacoes   ClassificacaoGrupo[]
}

model Jogador {
  id            Int           @id @default(autoincrement())
  nome          String
  posicao       String
  setor         String
  experiencia   Int
  idade         Int
  altura        Float
  peso          Float
  instagram     String
  instagram2    String
  cidade        String
  nacionalidade String
  timeFormador  String
  times         JogadorTime[]
  estatisticasJogo EstatisticaJogo[]
}

model JogadorTime {
  id           Int    @id @default(autoincrement())
  jogadorId    Int
  timeId       Int
  temporada    String 
  numero       Int
  camisa       String
  estatisticas Json 

  jogador Jogador @relation(fields: [jogadorId], references: [id])
  time    Time    @relation(fields: [timeId], references: [id])

  @@unique([jogadorId, timeId, temporada])
}

model Materia {
  id         Int      @id @default(autoincrement())
  titulo     String
  subtitulo  String
  imagem     String
  legenda    String?
  texto      String   @db.Text
  autor      String
  autorImage String
  createdAt  DateTime
  updatedAt  DateTime
}

model MetaDados {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String @db.Text
}

model Campeonato {
  id          Int      @id @default(autoincrement())
  nome        String   // "Brasileirão 2025"
  temporada   String   // "2025"
  tipo        String   // "REGULAR", "PLAYOFFS", "COPA"
  status      String   // "NAO_INICIADO", "EM_ANDAMENTO", "FINALIZADO"
  dataInicio  DateTime
  dataFim     DateTime?
  descricao   String?
  formato     Json     // Configurações do formato do campeonato
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  grupos      Grupo[]
  jogos       Jogo[]
  
  @@index([temporada])
  @@index([status])
}

model Grupo {
  id           Int         @id @default(autoincrement())
  nome         String      // "Grupo A", "Conferência Norte"
  campeonatoId Int
  ordem        Int         // Para ordenação dos grupos
  
  campeonato   Campeonato  @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  times        GrupoTime[]
  jogos        Jogo[]
  classificacoes ClassificacaoGrupo[]
  
  @@unique([campeonatoId, nome])
  @@index([campeonatoId])
}

model GrupoTime {
  id      Int   @id @default(autoincrement())
  grupoId Int
  timeId  Int
  
  grupo   Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  time    Time  @relation(fields: [timeId], references: [id], onDelete: Cascade)
  
  @@unique([grupoId, timeId])
}

model Jogo {
  id              Int        @id @default(autoincrement())
  campeonatoId    Int
  grupoId         Int?       // Null se não for jogo de grupo
  timeVisitanteId Int
  timeCasaId      Int
  dataJogo        DateTime
  local           String?
  rodada          Int
  fase            String     // "FASE_GRUPOS", "OITAVAS", "QUARTAS", "SEMI", "FINAL"
  status          String     @default("AGENDADO") // "AGENDADO", "AO_VIVO", "FINALIZADO", "ADIADO"
  placarCasa      Int?
  placarVisitante Int?
  observacoes     String?
  estatisticasProcessadas Boolean @default(false)
  
  campeonato      Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  grupo           Grupo?     @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  timeCasa        Time       @relation("JogosCasa", fields: [timeCasaId], references: [id])
  timeVisitante   Time       @relation("JogosVisitante", fields: [timeVisitanteId], references: [id])
  estatisticas    EstatisticaJogo[]
  
  @@index([campeonatoId, rodada])
  @@index([dataJogo])
  @@index([status])
  @@index([timeCasaId])
  @@index([timeVisitanteId])
}

model EstatisticaJogo {
  id           Int  @id @default(autoincrement())
  jogoId       Int
  jogadorId    Int
  timeId       Int
  estatisticas Json // Mesma estrutura das estatísticas existentes
  
  jogo         Jogo    @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  jogador      Jogador @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  time         Time    @relation(fields: [timeId], references: [id], onDelete: Cascade)
  
  @@unique([jogoId, jogadorId])
  @@index([jogoId])
  @@index([jogadorId])
}

model ClassificacaoGrupo {
  id           Int @id @default(autoincrement())
  grupoId      Int
  timeId       Int
  posicao      Int
  jogos        Int @default(0)
  vitorias     Int @default(0)
  empates      Int @default(0)
  derrotas     Int @default(0)
  pontosPro    Int @default(0)
  pontosContra Int @default(0)
  saldoPontos  Int @default(0)
  pontos       Int @default(0) // Pontos na tabela (vitória = 3, empate = 1)
  aproveitamento Float @default(0)
  
  grupo        Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  time         Time  @relation(fields: [timeId], references: [id], onDelete: Cascade)
  
  @@unique([grupoId, timeId])
  @@index([grupoId, posicao])
}